# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Python (in case a venv ends up outside backend/) ---
venv/
.venv/
env/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Node (in case node_modules ends up outside frontend/) ---
node_modules/
.next/
*.tsbuildinfo

# --- Secrets - never commit real keys ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Uploaded/generated runtime data ---
backend/storage/*
!backend/storage/.gitkeep

# --- Logs ---
*.log
npm-debug.log*